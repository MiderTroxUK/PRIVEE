{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/media/**",
              "components/slide/**",
              "components/ui/**",
              "tools/**",
              "ui_kits/presentation/**",
              "ui_kits/print_document/**",
              "ui_kits/reference_project/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Black|Arimo|Carlito))/i]",
        "message": "Font not provided by the design system. Available: Archivo Black, Arimo, Carlito."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|orientation|style|className|key|ref|className|style|children)$/]",
        "message": "<AccentBar> doesn't accept that prop. Declared props: tone, width, orientation, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|gradient|white|blue|yellow)$/]",
        "message": "<AccentBar> tone must be one of 'navy' | 'gradient' | 'white' | 'blue' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentBar'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<AccentBar> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Baseline'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|align|style|className|key|ref|className|style|children)$/]",
        "message": "<Baseline> doesn't accept that prop. Declared props: tone, size, align, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Baseline'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Baseline> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Baseline'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Baseline> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|size|marker|style|className|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, tone, size, marker, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<BulletList> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<BulletList> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='marker'] > Literal[value!=/^(?:dot|pipe|dash)$/]",
        "message": "<BulletList> marker must be one of 'dot' | 'pipe' | 'dash'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|icon|as|href|style|className|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, icon, as, href, style, className, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|blue|outline|ghost|onDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'blue' | 'outline' | 'ghost' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
