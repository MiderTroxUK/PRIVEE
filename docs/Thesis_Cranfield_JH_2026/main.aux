\@writefile{toc}{\contentsline {paragraph}{Widen the evidence base; it is the binding constraint.}{74}{section*.108}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The time block is repaired, and doing it corrected the instruction.}{74}{section*.109}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Fill the indicators before calibrating anything else.}{74}{section*.110}\protected@file@percent }
