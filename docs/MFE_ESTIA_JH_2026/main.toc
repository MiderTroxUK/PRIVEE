\contentsline {paragraph}{CE4 -- Taking the socio-ecological transition into account.}{40}{section*.67}%
\contentsline {paragraph}{CE5 -- Researching, selecting, qualifying and diffusing information, adapting it to its context.}{40}{section*.68}%
