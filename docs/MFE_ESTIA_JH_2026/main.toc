\contentsline {section}{\numberline {C}Detailed Competency Evidence}{42}{appendix.C}%
\contentsline {paragraph}{CI1 -- Analysis, synthesis, curiosity, creativity and innovation, approaching a problem systemically and across disciplines.}{42}{section*.80}%
\contentsline {paragraph}{CI3 -- Working in an international and intercultural context.}{42}{section*.81}%
\contentsline {paragraph}{CI5 -- Identifying and solving complex or research problems, mobilising scientific and technical knowledge and external resources.}{42}{section*.82}%
\contentsline {paragraph}{CE3 -- Leading, steering and controlling a project to reach its objectives, in cost, deadline, performance and risk.}{42}{section*.83}%
\contentsline {paragraph}{CE4 -- Taking the socio-ecological transition into account.}{42}{section*.84}%
\contentsline {paragraph}{CE5 -- Researching, selecting, qualifying and diffusing information, adapting it to its context.}{42}{section*.85}%
\contentsline {paragraph}{CST1 -- Defining an engineering strategy by choosing methods and tools suited to a known or poorly known context.}{42}{section*.86}%
\contentsline {paragraph}{CST2 -- Modelling and simulating a system, and capitalising the information and knowledge produced.}{43}{section*.87}%
\contentsline {paragraph}{CST7 -- Designing and building models, methods and tools to aid engineering and improve business processes, including in a research and development perspective.}{43}{section*.88}%
