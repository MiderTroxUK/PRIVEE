\contentsline {subsection}{\numberline {4.10}Discussion}{58}{subsection.4.10}%
\contentsline {paragraph}{The circularity problem is the central methodological finding.}{58}{section*.81}%
\contentsline {paragraph}{Ordering and level are separate problems needing separate fixes.}{59}{section*.82}%
\contentsline {paragraph}{The specific defect is repairable and general, but not in the obvious way.}{59}{section*.83}%
\contentsline {paragraph}{Communicating ignorance is a design requirement, not a nicety.}{59}{section*.84}%
\contentsline {paragraph}{Threats to validity.}{59}{section*.85}%
\contentsline {paragraph}{Against the pre-registered thresholds.}{60}{section*.86}%
