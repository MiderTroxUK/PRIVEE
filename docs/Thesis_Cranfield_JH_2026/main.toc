\contentsline {subsection}{\numberline {5.4}Future Work}{74}{subsection.5.4}%
\contentsline {paragraph}{Widen the evidence base; it is the binding constraint.}{74}{section*.108}%
\contentsline {paragraph}{The time block is repaired, and doing it corrected the instruction.}{74}{section*.109}%
\contentsline {paragraph}{Fill the indicators before calibrating anything else.}{74}{section*.110}%
\contentsline {paragraph}{Rebuild the calibration layer's training label on the product's target.}{74}{section*.111}%
\contentsline {paragraph}{Make the forecast state its own ignorance.}{75}{section*.112}%
\contentsline {paragraph}{Re-run the comparison with the display controlled.}{75}{section*.113}%
\contentsline {paragraph}{Run the human campaign.}{75}{section*.114}%
\contentsline {paragraph}{Put the outcome definition in the pre-registration.}{75}{section*.115}%
\contentsline {paragraph}{Connect the observed capacity channel.}{75}{section*.116}%
\contentsline {paragraph}{Broaden the elicitation and couple the platforms.}{75}{section*.117}%
